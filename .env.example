OPENAI_API_KEY=
GITHUB_TOKEN=                # shared fallback; per-request uses the approver's OAuth token
DATABASE_URL=postgresql://...   # AsyncPostgresSaver checkpointer (durable paused runs)
MIN_RELEVANCE_SCORE=0.35        # fallback only; tenants set min_relevance_score in
                                # policy.json. MEASURE it: python -m tools.calibrate

# --- models: WHERE they run (CRA_PLATFORM) and WHICH ones (CRA_PROFILE) ------
# The Studio is a REMOTE inference host, so it cannot be auto-detected. Set it
# explicitly or `auto` will describe the laptop running the graph instead.
CRA_PLATFORM=studio             # auto | mac | cuda | cpu | studio
CRA_PROFILE=studio              # portable | mac_resident | mac_max | studio
LLM_PROVIDER=lmstudio           # lmstudio | openai

# Reach the Studio over a TAILNET, never a public IP: LM Studio has no
# authentication, and the adapter's API key is a placeholder the server ignores.
LMSTUDIO_BASE_URL=http://<studio-host>:1234/v1

CRA_TEMPERATURE=0               # 0 for diagnosis: its output feeds a schema, then a gate
CRA_MAX_TOKENS=4096             # 2048 truncates findings[] on a large PR
# Model-server failures that are TRANSIENT (connection, timeout, 5xx, 429, LM
# Studio's mid-generation crash) are retried; a genuinely bad request is not.
CRA_LLM_RETRIES=2               # retries after the first attempt (0 disables)
CRA_LLM_RETRY_BACKOFF=5,15      # seconds between attempts; the last repeats
# --- retrieval (T10) -----------------------------------------------------------
RETRIEVER=indexed               # indexed (real, namespaced) | hybrid (4-doc offline demo)
EMBEDDER=lmstudio               # the pinned EMBEDDING_MODEL, on the LMSTUDIO_BASE_URL server
VECTOR_INDEX=local              # <CRA_DATA_DIR>/index/<namespace>/ -- build with tools.ingest
# CRA_CODEBASE_ROOT=~/Dev/<repo>  # where the tenant's repo lives on THIS machine;
                                  # policy.codebase.root is shared and may be a container path
ENTAILER=lexical                # lexical (offline default) | cross_encoder
# ENTAILER_MODEL=cross-encoder/nli-deberta-v3-base   # with ENTAILER=cross_encoder
MIN_ENTAILMENT_SCORE=0.25       # fallback; measure: python -m tools.calibrate ... entailment

# --- data storage (docs/DATA_STORAGE.md) -------------------------------------
# Audit records and log-review reports. Holds evidence-DERIVED text. T12 is
# closed, so secrets/PII are redacted before any model call and before anything
# lands here -- but redaction is pattern-based, not exhaustive, so still treat
# this as sensitive: do not commit it, sync it, or ship it to a log aggregator.
CRA_DATA_DIR=var                # audit/, traces/, live/, activity/, index/, reviews/
CRA_AUDIT=jsonl                 # jsonl | null (null records NOTHING -- tests only)
CRA_TRACE=jsonl                 # jsonl | null -- per-node and per-LLM-call spans (T23)
CRA_TRACE_PROMPTS=0             # every LLM call traces a prompt HASH; 1 also stores
                                # the PROMPT TEXT. Prompts are
                                # sanitised by the guard first, but a durable
                                # verbatim copy is still a wide surface.
CRA_GUARD=regex                 # regex | null -- the InputGuard (G5/T12). Redacts
                                # secrets/PII and escapes the fence markers before
                                # ANY model call. `null` disables it entirely and
                                # is for tests only, never a deployment.
DETECTOR=signals                # log-review anomaly detectors (G4)
CRA_ACTIVITY=jsonl              # jsonl | null -- the activity log (app/activity.py);
                                # null only for the offline gate suite and tests
CRA_ACTIVITY_LEVEL=INFO         # DEBUG | INFO | WARNING | ERROR
CRA_ENV=local                   # recorded on every activity entry (local | staging | prod)

# --- plumbing ------------------------------------------------------------------
TENANT_STORE=fs                 # where tenant policy + prompts come from
# TENANTS_DIR=tenants           # the fs store's root
SURFACES=code_review,log_review # what this deployment serves; a policy narrows it
