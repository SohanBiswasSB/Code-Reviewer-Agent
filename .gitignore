# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environments
.env
.env.*
# The annotated settings reference IS committed: it holds no values, only
# names and defaults, and TODO.md has long listed it as shipped.
!.env.example
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Editors / OS
# .vscode/settings.json IS committed (shared editor behaviour, see
# docs/DECISIONS.md); everything else under .vscode is local.
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Local artifacts
*.log
runs/
reports/

# Audit records, traces and log-review reports (docs/DATA_STORAGE.md). These hold
# evidence-derived text and, until T12 (InputGuard) lands, nothing redacts PII or
# secrets out of it. As sensitive as the source data -- never commit it.
var/
