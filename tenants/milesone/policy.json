{
  "codebase": {"name": "MilesOne Backend", "vcs": "github",
               "repo": "MilesEducation-Tech/Miles-USP-Backend", "language": "python",
               "root": "/repos/Miles-USP-Backend-PROD", "extra": "celery worker in same repo"},
  "enabled_surfaces": ["code_review", "log_review"],
  "code_review": {
    "min_relevance_score": 0.40,
    "severity_allowlist": ["low", "medium"],
    "allowed_actions": ["comment", "comment+label"],
    "escalate_to_human": true,
    "risky_areas": ["migrations", "auth", "credly", "celery", "routing", "zoom", "webhook"]
  },
  "log_review": {"min_relevance_score": 0.30, "anomaly_threshold": 3, "allowed_actions": ["report"],
                 "escalate_to_human": true}
}
