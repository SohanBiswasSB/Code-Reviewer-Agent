{
  "codebase": {"name": "Project A", "vcs": "github", "repo": "org/project-a",
               "language": "python", "root": "/repos/project-a"},
  "enabled_surfaces": ["code_review", "log_review"],
  "code_review": {
    "min_relevance_score": 0.40,
    "severity_allowlist": ["low", "medium"],
    "allowed_actions": ["comment", "comment+label"],
    "escalate_to_human": true,
    "risky_areas": ["migrations", "auth", "billing"]
  }
}
