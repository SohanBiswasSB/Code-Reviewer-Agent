{
  "codebase": {
    "name": "Human-readable project name",
    "vcs": "github",
    "repo": "org/repo-name",
    "language": "python",
    "root": "/repos/repo-name",
    "extra": "anything worth knowing, e.g. workers live in the same repo"
  },

  "enabled_surfaces": ["code_review"],

  "code_review": {
    "min_relevance_score": 0.40,
    "severity_allowlist": ["low", "medium"],
    "allowed_actions": ["comment", "comment+label"],
    "escalate_to_human": true,
    "risky_areas": ["migrations", "auth"]
  }
}
