{
  "codebase": {"name": "Project B", "vcs": "gitlab", "repo": "group/project-b",
               "language": "go", "root": "/repos/project-b"},
  "enabled_surfaces": ["code_review"],
  "code_review": {
    "min_relevance_score": 0.40,
    "severity_allowlist": ["low", "medium"],
    "allowed_actions": ["comment", "comment+label"],
    "escalate_to_human": true,
    "risky_areas": ["concurrency", "auth", "payments"]
  }
}
